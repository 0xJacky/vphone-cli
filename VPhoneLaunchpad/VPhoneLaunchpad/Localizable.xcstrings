      }
    },
    "Stop the machine to take, revert to or delete a snapshot." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop the machine to take, revert to or delete a snapshot." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショットを作成、復元、削除するには、マシンを停止してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스냅샷을 생성, 되돌리기 또는 삭제하려면 머신을 중지하십시오." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy dừng máy để tạo, hoàn nguyên hoặc xóa ảnh chụp nhanh." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止虚拟机后才能拍摄、恢复或删除快照。" } }
      }
    },
    "Take Snapshot of %@" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Take Snapshot of %@" } },
