    "Turned on or off in place, from the backups and the shared cache undo log." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップと共有キャッシュの取り消しログを使って、その場でオン／オフします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업과 공유 캐시 실행 취소 로그를 사용해 그 자리에서 켜거나 끕니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được bật hoặc tắt tại chỗ, dựa trên bản sao lưu và nhật ký hoàn tác của shared cache."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据备份和共享缓存撤销日志就地打开或关闭。"
          }
        }
      }
    },
    "Traffic leaves through this Mac's own connections, so it follows the Mac's VPN." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traffic leaves through this Mac's own connections, so it follows the Mac's VPN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信はこの Mac 自身の接続から送られるため、Mac の VPN を経由します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트래픽이 이 Mac의 자체 연결로 나가므로 Mac의 VPN을 따릅니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu lượng đi qua các kết nối của chính máy Mac này, nên sẽ đi theo VPN của máy Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流量从这台 Mac 自己的连接发出，因此会经过 Mac 的 VPN。"
          }
        }
      }
    },
