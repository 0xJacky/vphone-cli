    "Quitting stops creating this machine. You can retry later from the step where it stopped." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitting stops creating this machine. You can retry later from the step where it stopped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了すると、このマシンの作成が停止します。あとで停止したステップから再試行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료하면 이 머신의 생성이 중지됩니다. 나중에 중지된 단계부터 다시 시도할 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát sẽ dừng việc tạo máy ảo này. Bạn có thể thử lại sau từ bước đã dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出会停止创建此虚拟机。你可以稍后从停止的步骤重试。"
          }
        }
      }
    },
    "Re-patched from the machine’s originals and swapped into Preboot. No restore." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンの元のファイルから再度パッチを適用し、Preboot に入れ替えます。復元は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머신의 원본에서 다시 패치하여 Preboot에 교체합니다. 복원하지 않습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá lại từ bản gốc của máy ảo và thay vào Preboot. Không cần khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从虚拟机的原始文件重新修补并换入 Preboot，无需恢复。"
