    "%@ free on %@. A new machine’s 64 GB disk may not fit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ free on %2$@. A new machine’s 64 GB disk may not fit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ の空き容量は %1$@ です。新しいマシンの 64 GB のディスクが収まらない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 여유 공간이 %1$@입니다. 새 머신의 64GB 디스크가 들어가지 않을 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn trống %1$@ trên %2$@. Ổ đĩa 64 GB của máy ảo mới có thể không đủ chỗ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上剩余 %1$@。新虚拟机的 64 GB 磁盘可能放不下。"
          }
        }
      }
    },
    "%@ installs Core Bundles, allows each bundle’s vphone-vm to run, installs custom firmware and releases old guest addresses. Host Setup installs and updates it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はコアバンドルのインストール、各バンドルの vphone-vm の実行許可、カスタムファームウェアのインストール、古いゲストのアドレスの解放を行います。「ホスト設定」でインストールとアップデートを行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 코어 번들 설치, 각 번들의 vphone-vm 실행 허용, 커스텀 펌웨어 설치, 이전 게스트 주소 해제를 담당합니다. 호스트 설정에서 설치하고 업데이트합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cài Bundle lõi, cho phép vphone-vm của từng bundle chạy, cài firmware tùy chỉnh và giải phóng địa chỉ của các máy khách cũ. Thiết lập máy chủ sẽ cài đặt và cập nhật nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 负责安装核心 Bundle、允许各个 Bundle 的 vphone-vm 运行、安装自定义固件以及释放旧客户机的地址。它由“主机设置”安装和更新。"
          }
        }
      }
    },
    "%@ is a machine. Choose the folder that contains it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is a machine. Choose the folder that contains it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はマシンです。それを含むフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 머신입니다. 이 머신이 들어 있는 폴더를 선택하십시오."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là một máy ảo. Hãy chọn thư mục chứa nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是一台虚拟机。请选择包含它的文件夹。"
          }
        }
      }
    },
