    "Downloads firmware, patches the boot chain, restores and boots — in one run." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファームウェアのダウンロード、ブートチェーンへのパッチ適用、復元、起動を一度に行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펌웨어 다운로드, 부트 체인 패치, 복원, 시동을 한 번에 진행합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải firmware, vá chuỗi khởi động, khôi phục và khởi động — trong một lần chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次完成下载固件、修补启动链、恢复和启动。"
          }
        }
      }
    },
    "Every patch in this bundle, including advanced ones that may stop a newly restored 26.4 machine from starting." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every patch in this bundle, including advanced ones that may stop a newly restored 26.4 machine from starting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバンドルのすべてのパッチ。復元直後の 26.4 マシンが起動できなくなる可能性のある高度なパッチを含みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 번들의 모든 패치로, 새로 복원한 26.4 머신이 부팅하지 못하게 할 수 있는 고급 패치를 포함합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi bản vá trong gói này, bao gồm các bản vá nâng cao có thể khiến máy 26.4 vừa khôi phục không khởi động được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Bundle 中的全部补丁，包括可能导致刚恢复的 26.4 版本虚拟机无法启动的高级补丁。"
          }
        }
      }
    },
