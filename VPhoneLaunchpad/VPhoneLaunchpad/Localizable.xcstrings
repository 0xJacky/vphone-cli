    "New device identity" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New device identity" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいデバイス ID" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 기기 식별 정보" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Danh tính thiết bị mới" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新的设备身份" } }
      }
    },
    "The clone gets its own ECID, UDID and MAC address, so it can run alongside the original. The guest asks to trust this Mac again the first time it connects." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The clone gets its own ECID, UDID and MAC address, so it can run alongside the original. The guest asks to trust this Mac again the first time it connects." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "複製には独自の ECID、UDID、MAC アドレスが割り当てられるため、元のマシンと同時に実行できます。初めて接続するとき、ゲストはこの Mac を信頼するかどうかを再度確認します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "복제본은 고유한 ECID, UDID 및 MAC 주소를 받으므로 원본과 함께 실행할 수 있습니다. 처음 연결할 때 게스트가 이 Mac을 신뢰할지 다시 묻습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao nhận ECID, UDID và địa chỉ MAC riêng nên có thể chạy cùng lúc với máy gốc. Ở lần kết nối đầu tiên, máy khách sẽ hỏi lại có tin cậy máy Mac này không." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "克隆会获得自己的 ECID、UDID 和 MAC 地址，因此可以与原虚拟机同时运行。首次连接时，客户机会再次询问是否信任这台 Mac。" } }
      }
    },
    "The clone is the same device as the original. Run only one of them at a time." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The clone is the same device as the original. Run only one of them at a time." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "複製は元のマシンと同じデバイスです。同時に実行できるのはどちらか一方だけです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "복제본은 원본과 같은 기기입니다. 한 번에 하나만 실행하십시오." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản sao là cùng một thiết bị với máy gốc. Mỗi lúc chỉ chạy một trong hai máy." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "克隆与原虚拟机是同一台设备。两者同一时间只能运行一个。" } }
      }
    },
    "Snapshots…" : {
