    },
    "Give this to your coding agent, such as Claude Code, Codex or Grok. It reads the vphone skill from this Mac and installs it where that agent expects skills." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give this to your coding agent, such as Claude Code, Codex or Grok. It reads the vphone skill from this Mac and installs it where that agent expects skills."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code、Codex、Grok などのコーディングエージェントに渡してください。この Mac から vphone スキルを読み取り、そのエージェントがスキルを置く場所にインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex, Grok 같은 코딩 에이전트에 전달하세요. 이 Mac에서 vphone 스킬을 읽어 해당 에이전트가 스킬을 두는 위치에 설치합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa nội dung này cho agent lập trình của bạn, như Claude Code, Codex hoặc Grok. Agent sẽ đọc skill vphone trên máy Mac này và cài vào nơi agent đó tải skill."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这段话交给你的编程 Agent，例如 Claude Code、Codex 或 Grok。它会读取这台 Mac 上的 vphone skill，并装到该 Agent 存放 skill 的位置。"
          }
        }
      }
    },
