    "Low disk space: %@. A new machine’s 64 GB disk may not fit once the guest fills it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクの空き容量が少なくなっています：%@。ゲストが使い切ると、新しいマシンの 64 GB のディスクが収まらない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 공간 부족: %@. 게스트가 공간을 채우면 새 머신의 64GB 디스크가 들어가지 않을 수 있습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp hết dung lượng đĩa: %@. Ổ đĩa 64 GB của máy ảo mới có thể không đủ chỗ khi máy khách ghi đầy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘空间不足：%@。客户机写满后，新虚拟机的 64 GB 磁盘可能放不下。"
          }
        }
      }
    },
