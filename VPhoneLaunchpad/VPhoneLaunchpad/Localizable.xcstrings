    "Use an address on the Mac's shared NAT network, usually 192.168.64.0/24. For another subnet, use Tunnel." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use an address on the Mac's shared NAT network, usually 192.168.64.0/24. For another subnet, use Tunnel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac の共有 NAT ネットワーク（通常は 192.168.64.0/24）上のアドレスを使用してください。ほかのサブネットにはトンネルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac의 공유 NAT 네트워크(보통 192.168.64.0/24)의 주소를 사용하세요. 다른 서브넷에는 터널을 사용하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dùng địa chỉ trên mạng NAT dùng chung của máy Mac, thường là 192.168.64.0/24. Với mạng con khác, hãy dùng Đường hầm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用 Mac 共享 NAT 网络上的地址，通常是 192.168.64.0/24。其他子网请使用隧道模式。"
          }
        }
      }
    },
    "The tunnel hands this address to the guest itself." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tunnel hands this address to the guest itself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスはトンネル自身がゲストに割り当てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 터널이 직접 게스트에 할당합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường hầm tự cấp địa chỉ này cho máy khách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个地址由隧道直接分配给客户机。"
          }
        }
      }
    },
    "vphoned sets this address in the guest. Use your network's gateway and DNS servers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vphoned sets this address in the guest. Use your network's gateway and DNS servers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vphoned がゲスト内にこのアドレスを設定します。ネットワークのゲートウェイと DNS サーバを指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
