        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신의 디스크, SEP 저장소 및 NVRAM을 현재 상태 그대로 저장합니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Lưu ổ đĩa, bộ nhớ SEP và NVRAM của máy ảo ở trạng thái hiện tại." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按当前状态保存虚拟机的磁盘、SEP 存储和 NVRAM。" } }
      }
    },
    "Revert…" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Revert…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "되돌리기…" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn nguyên…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复…" } }
      }
    },
    "Revert %@ to “%@”?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Revert %@ to “%@”?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ を「%2$@」に復元しますか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%1$@을(를) “%2$@”(으)로 되돌리겠습니까?" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn nguyên %1$@ về “%2$@”?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将 %1$@ 恢复到“%2$@”？" } }
      }
    },
    "Revert" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Revert" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "되돌리기" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn nguyên" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复" } }
      }
    },
    "The machine's current disk, SEP storage and NVRAM are replaced with the snapshot's. Anything changed since then is lost unless you take a snapshot first." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The machine's current disk, SEP storage and NVRAM are replaced with the snapshot's. Anything changed since then is lost unless you take a snapshot first." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "マシンの現在のディスク、SEP ストレージ、NVRAM がスナップショットのものに置き換えられます。先にスナップショットを作成しておかないと、それ以降の変更はすべて失われます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "머신의 현재 디스크, SEP 저장소 및 NVRAM이 스냅샷의 것으로 대체됩니다. 먼저 스냅샷을 생성하지 않으면 그 이후의 변경 사항은 모두 사라집니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ổ đĩa, bộ nhớ SEP và NVRAM hiện tại của máy ảo sẽ được thay bằng của ảnh chụp nhanh. Mọi thay đổi kể từ đó sẽ mất, trừ khi bạn tạo ảnh chụp nhanh trước." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "虚拟机当前的磁盘、SEP 存储和 NVRAM 将被替换为快照中的版本。除非先拍摄快照，否则此后的所有更改都会丢失。" } }
      }
    },
    "Delete Snapshot “%@”?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete Snapshot “%@”?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショット「%@」を削除しますか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스냅샷 “%@”을(를) 삭제하겠습니까?" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xóa ảnh chụp nhanh “%@”?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除快照“%@”？" } }
      }
    },
    "The snapshot's files are removed. The machine itself is not changed. This cannot be undone." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The snapshot's files are removed. The machine itself is not changed. This cannot be undone." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショットのファイルが削除されます。マシン自体は変更されません。この操作は取り消せません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스냅샷의 파일이 제거됩니다. 머신 자체는 변경되지 않습니다. 이 작업은 실행 취소할 수 없습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các tệp của ảnh chụp nhanh sẽ bị xóa. Bản thân máy ảo không thay đổi. Không thể hoàn tác thao tác này." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快照的文件将被移除，虚拟机本身不受影响。此操作无法撤销。" } }
      }
    },
    "No Snapshots" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No Snapshots" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショットなし" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스냅샷 없음" } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không có ảnh chụp nhanh" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有快照" } }
      }
    },
    "Take a snapshot before you change the guest, so you can put it back later. A snapshot keeps the disk, SEP storage and NVRAM; settings and the Core Bundle are not part of it." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a snapshot before you change the guest, so you can put it back later. A snapshot keeps the disk, SEP storage and NVRAM; settings and the Core Bundle are not part of it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲストを変更する前にスナップショットを作成しておくと、あとで元の状態に戻せます。スナップショットにはディスク、SEP ストレージ、NVRAM が含まれます。設定とコアバンドルは含まれません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "게스트를 변경하기 전에 스냅샷을 생성해 두면 나중에 되돌릴 수 있습니다. 스냅샷에는 디스크, SEP 저장소 및 NVRAM이 포함되며, 설정과 코어 번들은 포함되지 않습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy tạo ảnh chụp nhanh trước khi thay đổi máy khách để có thể khôi phục sau này. Ảnh chụp nhanh giữ ổ đĩa, bộ nhớ SEP và NVRAM; cài đặt và Bundle lõi không nằm trong đó." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在更改客户机之前拍摄快照，以后就能恢复回来。快照包含磁盘、SEP 存储和 NVRAM，不包含设置和核心 Bundle。" } }
      }
    },
    "Try Again" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Try Again" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 시도" } },
