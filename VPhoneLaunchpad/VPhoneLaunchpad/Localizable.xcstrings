    "New Machine…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Machine…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新規マシン…"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 머신…"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảo mới…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新建虚拟机…"
          }
        }
      }
    },
    "New machines are bound to this bundle, and commands that belong to no machine run with it. Each machine keeps its own bundle until you change it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいマシンはこのバンドルに結び付けられ、どのマシンにも属さないコマンドもこのバンドルで実行されます。各マシンは、変更するまで自身のバンドルを使い続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 머신은 이 번들에 연결되며, 특정 머신에 속하지 않는 명령도 이 번들로 실행됩니다. 각 머신은 변경할 때까지 자체 번들을 계속 사용합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảo mới được gắn với bundle này, và các lệnh không thuộc máy ảo nào cũng chạy bằng nó. Mỗi máy ảo giữ bundle riêng cho đến khi bạn đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新虚拟机会绑定到这个 Bundle，不属于任何虚拟机的命令也用它运行。每台虚拟机会一直使用自己的 Bundle，直到你更改。"
          }
        }
      }
    },
    "New machines use the default. Each machine keeps its own." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいマシンはデフォルトを使用します。各マシンは自身のものを使い続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 머신은 기본값을 사용합니다. 각 머신은 자체 번들을 유지합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảo mới dùng bản mặc định. Mỗi máy ảo giữ bản riêng của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新虚拟机使用默认版本，每台虚拟机保留自己的版本。"
          }
        }
      }
    },
