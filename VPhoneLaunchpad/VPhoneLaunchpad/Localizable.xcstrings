        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘새로운 머신’은 마지막으로 생성한 폴더가 마운트되어 있고 사용 가능하면 그 폴더를, 그렇지 않으면 기본 라이브러리를 제시합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảo mới đề xuất thư mục đã tạo lần trước nếu nó còn được gắn và dùng được, nếu không thì dùng thư viện mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“新建虚拟机”会优先提供上次创建时使用的文件夹（前提是它已装载且可用），否则提供默认资料库。"
          }
        }
      }
    },
    "New Machines" : {
      "localizations" : {
