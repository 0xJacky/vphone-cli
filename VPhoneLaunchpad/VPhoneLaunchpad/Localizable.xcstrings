    "No network device. The guest stays offline; USB access and vphone.sock still work." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークデバイスはありません。ゲストはオフラインのままですが、USB アクセスと vphone.sock は引き続き使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 기기가 없습니다. 게스트는 오프라인 상태로 유지되지만 USB 접근과 vphone.sock은 계속 작동합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có thiết bị mạng. Máy khách luôn ngoại tuyến; truy cập USB và vphone.sock vẫn hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有网络设备。客户机保持离线；USB 访问和 vphone.sock 仍可使用。"
          }
        }
      }
    },
    "With no machine listed, every guest's lease would look orphaned." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With no machine listed, every guest's lease would look orphaned."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧にマシンがないと、すべてのゲストのリースが孤立したものに見えてしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에 머신이 없으면 모든 게스트의 임대가 고아로 보입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi không có máy nào trong danh sách, mọi hợp đồng thuê của máy khách đều trông như mồ côi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有列出任何机器时，所有客户机的租约都会被当作孤儿。"
          }
        }
      }
    },
