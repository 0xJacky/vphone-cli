        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选" } }
      }
    },
    "The snapshot keeps the machine's disk, SEP storage and NVRAM as they are now. Its settings and Core Bundle are not part of it." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The snapshot keeps the machine's disk, SEP storage and NVRAM as they are now. Its settings and Core Bundle are not part of it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スナップショットには、マシンのディスク、SEP ストレージ、NVRAM が現在の状態で保存されます。設定とコアバンドルは含まれません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스냅샷은 머신의 디스크, SEP 저장소 및 NVRAM을 현재 상태 그대로 보관합니다. 설정과 코어 번들은 포함되지 않습니다." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ảnh chụp nhanh giữ ổ đĩa, bộ nhớ SEP và NVRAM của máy ảo ở trạng thái hiện tại. Cài đặt và Bundle lõi không nằm trong đó." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快照会按当前状态保存虚拟机的磁盘、SEP 存储和 NVRAM，不包含其设置和核心 Bundle。" } }
      }
    },
    "Take Snapshot" : {
      "localizations" : {
