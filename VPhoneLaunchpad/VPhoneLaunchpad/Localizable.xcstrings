    "Creation continues if you close the window. Start, settings and export wait until it finishes." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを閉じても作成は続行されます。開始、設定、書き出しは作成が終わるまで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 닫아도 생성은 계속됩니다. 시작, 설정 및 내보내기는 생성이 끝날 때까지 기다립니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình tạo vẫn tiếp tục nếu bạn đóng cửa sổ. Khởi động, cài đặt và xuất sẽ chờ đến khi tạo xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭窗口后创建仍会继续。启动、设置和导出需等它完成后才能进行。"
          }
        }
      }
    },
    "Creation continues if you close this window." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creation continues if you close this window."
          }
