      }
    },
    "%@ will be deleted. The machine starts from its disk without them. Restoring it again prepares the firmware anew, from the IPSW cache while the IPSWs are still there." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が削除されます。マシンはこれらがなくてもディスクから起動します。もう一度復元すると、ファームウェアが改めて準備されます。IPSW が残っていれば IPSW キャッシュから準備されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 삭제됩니다. 머신은 이 파일 없이도 디스크에서 시동됩니다. 다시 복원하면 펌웨어를 새로 준비하며, IPSW가 남아 있으면 IPSW 캐시에서 준비합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ bị xóa. Máy ảo vẫn khởi động từ ổ đĩa mà không cần chúng. Khôi phục lại sẽ chuẩn bị firmware từ đầu, dùng bộ nhớ đệm IPSW khi các IPSW vẫn còn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除 %@。虚拟机不需要它们也能从磁盘启动。再次恢复时会重新准备固件；只要 IPSW 还在，就会使用 IPSW 缓存。"
          }
        }
      }
    },
