        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy cập nhật trình trợ giúp đặc quyền trong Thiết lập máy chủ, rồi thử lại." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在“主机设置”中更新特权 Helper，然后重试。" } }
      }
