    "The Core Bundle of %@ is not installed. Choose another Core Bundle for it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Core Bundle of %@ is not installed. Choose another Core Bundle for it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のコアバンドルがインストールされていません。別のコアバンドルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 코어 번들이 설치되어 있지 않습니다. 다른 코어 번들을 선택하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
