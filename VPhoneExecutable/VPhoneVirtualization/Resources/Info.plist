<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.vphone.bundle</string>
	<key>CFBundleName</key>
	<string>VPhone</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.6.0</string>
	<key>CFBundleVersion</key>
	<string>32</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Shares this Mac's microphone with the virtual iPhone so apps running inside it can record.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>VPhone Terminal Tab</string>
			<key>UTTypeIdentifier</key>
			<string>com.vphone.terminal-tab</string>
		</dict>
	</array>
	<!-- This fork's builds: a label beside the version, which stays the
	     upstream number so Launchpad's series matching is untouched. -->
	<key>VPhoneBuildVariant</key>
	<string>ui</string>
</dict>
</plist>
